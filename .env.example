# ---------------------------------------------------------------------------
# VIP Transport — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ---------------------------------------------------------------------------

# Contact form delivery endpoint.
# The form POSTs JSON here. Leave BLANK to run the site with the form in
# "preview" mode (it validates input and tells the user delivery isn't wired up
# yet, instead of faking a successful send).
#
# Easiest options that need no server of your own:
#   - Formspree:  https://formspree.io/f/XXXXXXXX
#   - Web3Forms:  https://api.web3forms.com/submit   (also set VITE_CONTACT_ACCESS_KEY)
#   - Your own API route that accepts { name, company, phone, email, ... }
VITE_CONTACT_ENDPOINT=

# Only needed for providers (e.g. Web3Forms) that require an access key in the
# POST body. Safe to expose for those services; still treat as config, not a secret.
VITE_CONTACT_ACCESS_KEY=
